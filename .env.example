# Copy this file to .env and fill in your own key:
#   cp .env.example .env
#
# Required to reproduce the dissertation's spot-gold benchmark (Alpha Vantage
# GOLD_SILVER_HISTORY). Get a free key at https://www.alphavantage.co/support/#api-key
#
# Without this key (and no cached data/raw/gold_alphavantage_daily.json),
# 02_data_pull/pull_market_data.py and scripts/fetch_market_data.py will now
# fail with a clear error rather than silently substituting Yahoo GC=F
# futures as the gold benchmark. Pass --allow-futures-fallback to either
# script if you explicitly want that substitution for quick experimentation
# (note: results produced that way will NOT match the spot-gold tables in
# the dissertation).
ALPHAVANTAGE_API_KEY=your_api_key_here
